{
  // Lead Store: the customer-facing app (docs/store-api.md). Deploy with
  //   npx wrangler deploy -c wrangler.store.jsonc
  // It shares the business database with the internal app (same database_id) and has nothing
  // else: no API keys, no queues, no scheduled jobs. Migrations are applied from wrangler.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lead-store",
  "main": "src/store/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lead-scraper-db",
      "database_id": "cafa4171-18dc-4dba-bbc0-ef86a1561cd0",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "LEAD_TIMEZONE": "America/New_York" }
}
